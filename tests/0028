# Run the self-tests for the blinking top light

set l:0x8C009E68 0x80013ee4	# Needed for drawing glyphs on screen
set R15 0x0C001000			# Mock a stack somewhere
set l:0x8C009C20 0xb2000000	# This global points to the motherboard registers

# This function sets the VBR and the default exception handlers.
set PC 0x8003F044
break 0x8003F108
run
step 2

# The hardware interrupt handler at <0x8003EBC8> uses a static variable to
# discard 99 out of every 100 interrupts. No idea what this is about, but for
# this test just patch it away.
patch 0x8003EBDA 0x0009

# <0x80036E38> is responsible for setting the inner interrupt handlers that get
# called by <0x8003EBC8>. When unset, this static variable at 0x8C009E84 blocks
# the setup from happening twice.
set l:0x8C009E84 1

# <0x80037078> waits for an interrupt and then plays a sound. Audio is not yet
# implemented so just patch that out so that we can focus on the blinking.
patch 0x80037094 0x0009

# The actual self-tests. Always break right before returning from printf() to
# screen so that we can check the display contents.
set R4 0
set PC 0x80038C18
step 2000000
break 0x80037278

# Press any button to update the display
input QL1
run
step
input QL1
step 100000
# We blinked 4 times, so the blink count will be 65535 - 4
print --raw CRC

# The so-called "Start button" with interrupt id 0x11 is supposed to stop the
# blinking, but I don't know what that is. Just push any button and change the
# id after it gets read.
break 0x80038E50
input QL1
run
set R0 0x11
run
step
input QL1
step 100000
# The blink count should be the same now, and the blinking stopped
print --raw CRC

# Confirm that it's indeed not blinking
step 2000000
input QL1
run			# Until 0x80038E50
run			# Until the blink is printed
step
input QL1
step 10000	# Let the interrupt handler run
print --raw CRC

# The wheel can be used to adjust the remaining blink count. Make it wrap
# around back to 2. TODO: this is ugly, implement loops or something.
input up
run
run
step
input up
step 100000
# 65532
input up
run
run
step
input up
step 100000
# 65533
input up
run
run
step
input up
step 100000
# 65534
input up
run
run
step
input up
step 100000
# 65535
input up
run
run
step
input up
step 100000
# 0
input up
run
run
step
input up
step 100000
# 1
input up
run
run
step
input up
step 100000
# 2
print --raw CRC

# Make the light blink again until it stops on its own
input enter
run
run
step
input enter
# Let the blinks run out and then push any button to update the display again
step 2000000
input QL1
run
run
step
input QL1
step 100000
# The blink count should be 0 now, and the blinking stopped
print --raw CRC

# The On/Off button ends the test
input onoff
step 100000
input onoff
run
run
step
# "Notification Done"
print --raw CRC
exit
