xxd 0x0C010000 0x18

# 83492.785 / -947343.64 ~= -0.08813
set PC 0x800412E8
set R4 0x0C010000
set R5 0x0C010008
set R6 0x0C010010
set l:0x0C010008 0x8f5c28f6
set l:0x0C01000C 0x40f4624c
set l:0x0C010010 0x47ae147b
set l:0x0C010014 0xc12ce91f
run
