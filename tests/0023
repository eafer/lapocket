set PC 0x800412E8
set R4 0x0C010000
set R5 0x0C010008
set R6 0x0C010010
set l:0x0C010008 0x00000000
set l:0x0C01000C 0x7fff0000
set l:0x0C010010 0x000000ff
set l:0x0C010014 0xfff00000
run
