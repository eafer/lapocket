# Tests a function to divide doubles that I encountered while investigating pen
# input. It uses three new instructions: XORI, CLRT and ROTR.

set R15 0x0C001000			# Mock a stack somewhere
break 0x80041482			# Break before returning

# R5 points to the dividend, and R6 to the divisor. The output will go to the
# R4 address.

# 30.0 / 30.0 = 1.0
set PC 0x800412E8
set R4 0x0C010000
set R5 0x0C010008
set R6 0x0C010010
set l:0x0C010008 0x00000000
set l:0x0C01000C 0x403e0000
set l:0x0C010010 0x00000000
set l:0x0C010014 0x403e0000
run
step
xxd 0x0C010000 0x18

# 1.0 / 0.0 = Infinity
set PC 0x800412E8
set R4 0x0C010000
set R5 0x0C010008
set R6 0x0C010010
set l:0x0C010008 0x00000000
set l:0x0C01000C 0x3ff00000
set l:0x0C010010 0x00000000
set l:0x0C010014 0x00000000
run
step
xxd 0x0C010000 0x18

# 0.0 / 0.0 = NaN
set PC 0x800412E8
set R4 0x0C010000
set R5 0x0C010008
set R6 0x0C010010
set l:0x0C010008 0x00000000
set l:0x0C01000C 0x00000000
set l:0x0C010010 0x00000000
set l:0x0C010014 0x00000000
run
step
xxd 0x0C010000 0x18

# 1.0 / -Infinity = -0.0
set PC 0x800412E8
set R4 0x0C010000
