# Tests the printf() to console of nknodbg.exe
#
# Note that this function doesn't seem to count the added carriage returns as
# part of the output string length.

set R15 0x0C001000 # Mock a stack somewhere
break 0x800380E6 # Break before returning

set R4 0x8002b7f4 # "WarmBoot"
set PC 0x800380CC
run
dump cpu # R0 should have the length: 8

set R4 0x8002b8a0 # "\nThis Menu %s not yet implemented!"
set R5 0x8002b7f4 # "WarmBoot"
set PC 0x800380CC
run
dump cpu # R0 should have the length: 0x28

set R4 0x8002b7c6 # "%3d %c%-30s"
set R5 17
set R6 0x58 # 'X'
set R7 0x0002b875 # "Press any key"
set PC 0x800380CC
run
dump cpu # R0 should have the length: 0x23

set R4 0x0002b859 # "Invalid Remote cmd %c H%X"
set R5 0x59 # 'Y'
set R6 0xd71a5ebb
set PC 0x800380CC
run
dump cpu # R0 should have the length: 0x1e

set R4 0x8002a79c # "Contrast=%d%%"
set R5 78
set PC 0x800380CC
run
dump cpu # R0 should have the length: 0xc

# This thing has binary conversion specifiers
set R4 0x80e06eed # "I%B,"
set R5 0x137f0124
set PC 0x800380CC
run
dump cpu # R0 should have the length: 0x1f

set R4 0x8021809a # "b%bc"
set R5 0x137f0124
set PC 0x800380CC
run
dump cpu # R0 should have the length: 0x1f

# No floating point support
exit
