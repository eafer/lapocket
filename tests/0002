# Tests strlen() with the firmware string at 0x0000045c, starting at four
# different offsets to cover the whole jumptable.

# Coredll isn't mapped yet: fake it.
map 0x01fa0400 0x80082000 0x00045400
# Break before returning so that we can check the length
break 0x800b2fd6

set R4 0x8000045c
set PC 0x800B2F84
run
step 2
dump cpu # R0 should have the lenght: 0x26

set R4 0x8000045d
set PC 0x800B2F84
run
step 2
dump cpu # R0 should have the lenght: 0x25

set R4 0x8000045e
set PC 0x800B2F84
run
step 2
dump cpu # R0 should have the lenght: 0x24

set R4 0x8000045f
set PC 0x800B2F84
run
step 2
dump cpu # R0 should have the lenght: 0x23

exit
