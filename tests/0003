# Tests strstr() with the firmware string at 0x00000484, and the substring at
# 0x0002ad44 ("EEPROM").

# Mock a stack somewhere
set R15 0x0C001000
# Put some values here to confirm that they get preserved in the stack
set R8 0x7234
set R9 0x9218

set R4 0x80000484
set R5 0x8002ad44
set PC 0x800b3088
break 0x800b30ce
run
step
dump cpu # R0 should have the pointer to the substring: 0x8000048b

exit
